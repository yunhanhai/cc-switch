{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YunSwitch",
  "version": "3.20.1-yunswitch.5",
  "identifier": "io.github.yunhanhai.yunswitch",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "titleBarStyle": "Overlay",
        "width": 1000,
        "height": 650,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; script-src 'self' 'sha256-ls27Lc1OytcVawXPVMplz6LyKz2i9KYAVBw3u79qyB4='; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "publisher": "yunhanhai",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../licenses/": "licenses/"
    },
    "homepage": "https://github.com/yunhanhai/yunswitch",
    "shortDescription": "AI coding tool configuration and routing manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "template": "wix/per-user-main.wxs",
        "version": "3.20.1.5",
        "upgradeCode": "30b9d4b3-1c8e-4653-aacc-2fec007d1122",
        "fragmentPaths": ["wix/third-party-notices.wxs"],
        "componentGroupRefs": ["ThirdPartyNotices"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["yunswitch"]
      }
    },
    "updater": {
      "active": false,
      "pubkey": "",
      "endpoints": []
    }
  }
}
